# Bu dosyayı .env adıyla kopyalayıp doldurun (backend klasöründe). .env git'e girmez.
# Biçim: ANAHTAR=değer (tırnak ve boşluk kullanmayın). Kullanmadığınız satırı # ile kapalı bırakın.

#GROQ_API_KEY=
#FEATHERLESS_API_KEY=
#GEMINI_API_KEY=

# Sahne resimleri: Cloudflare Workers AI (dash.cloudflare.com > AI > Workers AI > REST API)
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_API_TOKEN=

# Seslendirme: GEMINI_API_KEY yeterlidir (Gemini TTS, ücretsiz kota). Ses adı isteğe bağlı.
#GEMINI_TTS_VOICE=Kore
# Yedek seslendirme: Murf AI (murf.ai > API > API Keys)
#MURF_API_KEY=
#MURF_STYLE=Narration
# Son yedek seslendirme: Azure AI Speech, ücretsiz F0 (portal.azure.com > Speech kaynağı > Keys and Endpoint)
#AZURE_SPEECH_KEY=
#AZURE_SPEECH_REGION=westeurope
