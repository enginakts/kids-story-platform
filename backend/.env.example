# Bu dosyayı .env adıyla kopyalayıp doldurun (backend klasöründe). .env git'e girmez.
# Biçim: ANAHTAR=değer (tırnak ve boşluk kullanmayın). Kullanmadığınız satırı # ile kapalı bırakın.

#GROQ_API_KEY=
#FEATHERLESS_API_KEY=
#GEMINI_API_KEY=

# Sahne resimleri: Cloudflare Workers AI (dash.cloudflare.com > AI > Workers AI > REST API)
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_API_TOKEN=

# Kikiri modeli ve ses servisi için (yerelde; Space için) örnek
#KIKIRI_TTS_URL=http://localhost:8000
#KIKIRI_TTS_TOKEN=
#KIKIRI_TTS_HF_TOKEN=
